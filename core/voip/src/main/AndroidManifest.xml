<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".VoipIncomingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:taskAffinity="" />

        <service
            android:name=".voip.VoipCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <!-- Keeps the signaling connection alive when the app is in the background -->
        <service
            android:name=".voip.BackgroundVoipService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <receiver
            android:name=".voip.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
